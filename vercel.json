{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "python",
  "fluid": true,
  "functions": {
    "asgi.py": {
      "maxDuration": 300,
      "excludeFiles": "{tests/**,scripts/**,artifacts/**,.venv/**,.pytest_cache/**,**/__pycache__/**,requirements-dev.txt,requirements-lock.txt,PROJECT_GUIDE.md}"
    }
  }
}
